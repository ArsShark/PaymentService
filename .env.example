# Copy this file to .env (it is ignored by Git) and set real values.
# The application reads this file too (profile local, as Java properties): no quotes around a
# value, no backslash, no spaces around "=". Pick passwords without $ and # for local work.

# The administrator of the MongoDB container. The image creates it on the FIRST start of an empty
# data volume, and the script of docker/mongodb uses it to create the user below. The
# application never uses it.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# The user of the application. The script creates it on the same first start, with a role of
# readWrite plus collMod on the one database of the application. Changing these values later
# changes nothing in MongoDB: reset it with "docker compose down -v", which deletes the data.
MONGO_USERNAME=payment
MONGO_PASSWORD=change-me

# Optional: the name of the database (the default is payment_service_db). It is used by the
# container, by the script and by the application on the host alike.
# MONGO_DB=payment_service_db

# Optional: the port published on 127.0.0.1 by docker-compose.dev.yml (the default is 27017).
# The container of the application does not read it.
# MONGO_PORT=27017

# Optional: the address of the random number service (the default is https://www.random.org).
# The container of the application reads it too.
# RANDOM_API_URI=https://www.random.org

# Optional: the port of Kafka published on 127.0.0.1 by docker-compose.dev.yml (the default is
# 9092). If you change it, set KAFKA_BOOTSTRAP_SERVERS=localhost:<port> too: the application on
# the host reads that variable. The container of the application never reads either of them.
# KAFKA_PORT=9092
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional: the key set of the Authentication Service and the issuer an access token must have
# (the default is authentication-service). Both must match the Authentication Service.
# The container of the application reads both: its default for the key set is
# http://host.docker.internal:8081/.well-known/jwks.json. Do NOT set a localhost address for
# AUTH_JWKS_URI while you use the container: there "localhost" is the container itself.
# AUTH_JWKS_URI=http://host.docker.internal:8081/.well-known/jwks.json
# JWT_ISSUER=authentication-service
