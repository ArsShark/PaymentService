# Copy this file to .env (it is ignored by Git) and set real values.
# The application reads this file too (profile local, as Java properties): no quotes around a
# value, no backslash, no spaces around "=". Pick a password without $ and # for local work.

# The root user of the MongoDB container, also the user of the application.
MONGO_USERNAME=payment
MONGO_PASSWORD=change-me

# Optional: the port published on 127.0.0.1 (the default is 27017).
# MONGO_PORT=27017

# Optional: the address of the random number service (the default is https://www.random.org).
# RANDOM_API_URI=https://www.random.org

# Optional: the port of Kafka published on 127.0.0.1 (the default is 9092). If you change it, set
# KAFKA_BOOTSTRAP_SERVERS=localhost:<port> too: the application on the host reads that variable.
# KAFKA_PORT=9092
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional: the key set of the Authentication Service (the default is
# http://localhost:8081/.well-known/jwks.json) and the issuer an access token must have (the
# default is authentication-service). Both must match the Authentication Service.
# AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
# JWT_ISSUER=authentication-service
